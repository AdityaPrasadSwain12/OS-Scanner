# LOCAL DEVELOPMENT TEMPLATE ONLY. Never reuse these placeholder values in production.
# Prefer scripts/cloud/Initialize-CloudEnvironment.ps1, which generates random local values.
SCANNER_ENVIRONMENT=development
CLOUD_BIND_ADDRESS=127.0.0.1
CLOUD_API_PORT=8080
CLOUD_DASHBOARD_PORT=8081
CLOUD_TENANT_ID=tenant-local
POSTGRES_DATABASE=scanner
POSTGRES_USER=scanner
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_PASSWORD
CLOUD_ENROLLMENT_TOKEN=REPLACE_WITH_RANDOM_LOCAL_ENROLLMENT_TOKEN
CLOUD_ADMIN_TOKEN=REPLACE_WITH_RANDOM_LOCAL_ADMIN_TOKEN
SCANNER_CREDENTIAL_PEPPER=REPLACE_WITH_RANDOM_LOCAL_CREDENTIAL_PEPPER

# The real tool image is the default. Set this only in an explicitly isolated fixture test.
SCANNER_ANALYSIS_FIXTURE_MODE=false
