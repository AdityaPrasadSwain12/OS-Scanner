<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.enterprise.endpoint-scanner</string>
  <key>UserName</key>
  <string>_endpointscanner</string>
  <key>GroupName</key>
  <string>_endpointscanner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Application Support/EndpointScanner/bin/endpoint-scanner</string>
    <string>agent</string>
    <string>--config</string>
    <string>/Library/Application Support/EndpointScanner/config.yaml</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Library/Application Support/EndpointScanner</string>
  <key>Disabled</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Library/Logs/EndpointScanner/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/EndpointScanner/stderr.log</string>
  <key>ThrottleInterval</key>
  <integer>15</integer>
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>4096</integer>
  </dict>
  <key>HardResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>8192</integer>
  </dict>
</dict>
</plist>
